{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAGE Emblem Codec",
  "version": "0.1.5",
  "identifier": "tools.rage.emblemcodec",
  "build": {
    "beforeDevCommand": "npm run serve",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RAGE Emblem Codec",
        "width": 1540,
        "height": 980,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "maximized": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ]
  }
}
